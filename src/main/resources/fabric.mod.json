{
  "schemaVersion": 1,
  "id": "modradio",
  "version": "${version}",
  "name": "ModRadio",
  "description": "Lunar-style radio HUD that shows whatever Windows is playing (Spotify, browser, etc.) with cover art, progress, and media controls.",
  "authors": ["gng"],
  "license": "MIT",
  "environment": "client",
  "entrypoints": {
    "client": [
      {
        "adapter": "kotlin",
        "value": "dev.gng.modradio.ModRadioClient"
      }
    ],
    "modmenu": [
      {
        "adapter": "kotlin",
        "value": "dev.gng.modradio.ModMenuIntegration"
      }
    ]
  },
  "depends": {
    "fabricloader": ">=0.19.5",
    "minecraft": "~26.3",
    "java": ">=25",
    "fabric-api": "*",
    "fabric-language-kotlin": "*"
  },
  "suggests": {
    "modmenu": "*"
  }
}
